# The Discus Den — server env reference. Do NOT commit real values.
# On Vercel set these under Project the-discus-den-web -> Settings -> Environment Variables.
# (DATABASE_URL and auth creds are injected by the platform.)

# --- Chat Assistant (POST /api/chat) ---
# CHAT_EXTRA_ORIGINS=https://preview.example.com
# CHAT_IP_SALT=<random string>
# CHAT_PRICE_CACHE_SECONDS=60
# CHAT_ALERT_IP_CAP_24H=2
# CHAT_ALERT_GLOBAL_CAP_HOUR=20

# --- Chat lead alerts (email via Resend) ---
# off (default, log only) | console | email
CHAT_LEAD_ALERT_MODE=email
# Resend API key with "Sending access" (https://resend.com/api-keys). Secret.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Who receives lead alerts (Shiva's inbox; must be the Resend account email while using onboarding@resend.dev)
CHAT_LEAD_ALERT_EMAIL_TO=shivamahadev7007@gmail.com
# Optional sender. Default works without a domain (Resend test sender):
# CHAT_LEAD_ALERT_FROM=The Discus Den Chat <onboarding@resend.dev>
# Optional send timeout in ms (default 5000, max 10000):
# CHAT_LEAD_ALERT_TIMEOUT_MS=5000
